# Copia questo file in .env (nella stessa cartella) e compila i valori.
# Il file .env è ignorato da git: le credenziali NON vanno mai committate.

EMAIL_USER=scuole@buildinterest.it

# ATTENZIONE: la mail è su Google Workspace, quindi la password normale
# dell'account NON funziona via SMTP. Serve una "password per le app":
#   1. Attiva la verifica in due passaggi sull'account Google
#   2. Vai su https://myaccount.google.com/apppasswords
#   3. Crea una password per le app e incollala qui sotto (16 caratteri)
EMAIL_PASSWORD=

# Opzionali (valori di default già corretti per Gmail/Google Workspace)
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=465
#EMAIL_FROM_NAME=Interest — Scuole
